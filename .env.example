# Alpaca API Credentials
# Get these from: https://app.alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use paper trading for testing

# News API
# Get from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Reddit API
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TradingBot/1.0

# Twitter/X API (Optional)
# Get from: https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Database
DATABASE_URL=sqlite:///./trading_bot.db

# Trading Parameters
MAX_POSITION_SIZE=1000  # Maximum dollars per position
MAX_PORTFOLIO_RISK=0.02  # Maximum 2% risk per trade
TRADING_MODE=paper  # paper or live
